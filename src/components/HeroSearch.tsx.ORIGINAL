import { Search, Mic } from "lucide-react";
import { useNavigate } from "@tanstack/react-router";
import { useEffect, useRef, useState } from "react";

import { getAutoVoiceCapability, transcribeAutoVoice } from "@/lib/autoVoice.functions";
import {
  normalizeSearchQuery,
  preferredVoiceLocale,
  selectBestVoiceTranscript,
  VOICE_LOCALE_OPTIONS,
  type VoiceLocale,
} from "@/lib/searchLanguage";

const PROFILES = ["ALL", "Children", "Pregnant Women", "Seniors"] as const;
const VOICE_LOCALE_STORAGE_KEY = "sp_voice_locale";
const VOICE_MODE_STORAGE_KEY = "sp_voice_mode";
const AUTO_VOICE_MAX_MS = 7_000;
export type Profile = (typeof PROFILES)[number];
type VoiceMode = "auto" | VoiceLocale;

function isVoiceLocale(value: string | null): value is VoiceLocale {
  return value === "en-IN" || value === "hi-IN" || value === "pa-IN";
}

function recorderMimeType() {
  if (typeof MediaRecorder === "undefined") return "";
  const candidates = ["audio/webm;codecs=opus", "audio/mp4", "audio/webm", "audio/ogg;codecs=opus"];
  return candidates.find((candidate) => MediaRecorder.isTypeSupported(candidate)) ?? "";
}

function blobToDataUrl(blob: Blob): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => typeof reader.result === "string" ? resolve(reader.result) : reject(new Error("INVALID_AUDIO"));
    reader.onerror = () => reject(reader.error ?? new Error("AUDIO_READ_FAILED"));
    reader.readAsDataURL(blob);
  });
}

export function ProfilePills({ value, onChange }: { value: Profile; onChange: (p: Profile) => void }) {
  return (
    <div className="flex flex-wrap items-center justify-center gap-1.5">
      <span className="mr-1 text-[10px] font-bold uppercase text-body">Profile</span>
      {PROFILES.map((p) => {
        const active = p === value;
        return (
          <button
            key={p}
            onClick={() => onChange(p)}
            className={`rounded-full px-4 py-1.5 text-[11px] font-bold transition-all sm:text-xs ${
              active
                ? "bg-[#38BDF8] text-[#0F1419] shadow-lg shadow-[#38BDF8]/20"
                : "border border-white/10 bg-white/5 text-slate-400 hover:bg-white/10 hover:text-slate-200"
            }`}
          >
            {p}
          </button>
        );
      })}
    </div>
  );
}

export function SearchBar({
  value,
  onChange,
  onSubmit,
  voiceListening,
  onVoice,
  voiceMode = "en-IN",
  autoVoiceAvailable = false,
  onVoiceModeChange = () => {},
  voiceMessage,
}: {
  value: string;
  onChange: (v: string) => void;
  onSubmit: () => void;
  voiceListening?: boolean;
  onVoice?: () => void;
  voiceMode?: VoiceMode;
  autoVoiceAvailable?: boolean;
  onVoiceModeChange?: (mode: VoiceMode) => void;
  voiceMessage?: string | null;
}) {
  return (
    <form
      onSubmit={(e) => { e.preventDefault(); onSubmit(); }}
      className="relative mx-auto w-full max-w-4xl"
    >
      <div className="flex items-center gap-1 rounded-2xl border border-divider bg-muted p-1.5 shadow-2xl transition-all focus-within:border-brand-blue/40 focus-within:ring-2 focus-within:ring-brand-blue/20">
        <Search className="ml-2.5 h-4 w-4 shrink-0 text-slate-500" />
        <input
          value={value}
          onChange={(e) => onChange(e.target.value)}
          placeholder="Search any product or ingredient..."
          className="min-w-0 flex-1 bg-transparent px-2 py-2 text-[13px] text-slate-100 placeholder:text-slate-600 focus:outline-none sm:text-sm"
        />
        <button
          type="button"
          onClick={onVoice}
          aria-label={voiceListening ? "Stop voice search" : "Start voice search"}
          aria-pressed={voiceListening}
          className="grid h-9 w-9 shrink-0 place-items-center rounded-full text-brand-blue shadow-[0_0_18px_color-mix(in_oklab,var(--color-brand-blue)_35%,transparent)] transition hover:bg-brand-blue/10"
        >
          <Mic className={`h-5 w-5 ${voiceListening ? "animate-pulse text-brand-orange" : "text-brand-blue"}`} />
        </button>
        <button
          type="submit"
          style={{ backgroundColor: "#38BDF8" }}
          className="shrink-0 rounded-xl px-4 py-2.5 text-[11px] font-extrabold transition-transform active:scale-[0.97] sm:text-xs"
        >
          <span style={{ color: "#065F46" }}>Safe</span><span style={{ color: "#92400E" }}>Price</span>
        </button>
      </div>

      {onVoice ? (
        <div className="mt-2 flex flex-wrap items-center justify-end gap-2 px-1 text-[10px] text-slate-500">
          <span>{voiceListening ? "Listening…" : voiceMessage ?? (voiceMode === "auto" ? "Auto voice: English • हिंदी • ਪੰਜਾਬੀ" : "Voice language")}</span>
          <select
            value={voiceMode}
            onChange={(event) => onVoiceModeChange(event.target.value as VoiceMode)}
            aria-label="Voice search language mode"
            className="rounded-md border border-divider bg-card px-2 py-1 text-[10px] text-heading focus:border-brand-blue/40 focus:outline-none"
          >
            {autoVoiceAvailable ? <option value="auto">Auto — EN / हिंदी / ਪੰਜਾਬੀ</option> : null}
            {VOICE_LOCALE_OPTIONS.map((option) => (
              <option key={option.value} value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
      ) : null}
    </form>
  );
}

export function HeroSearch({
  initialQ = "",
  initialProfile = "ALL",
  onSubmit,
  onProfileBrowse,
}: {
  initialQ?: string;
  initialProfile?: Profile;
  onSubmit?: (q: string, profile: Profile) => void;
  onProfileBrowse?: (profile: Profile) => void;
}) {
  const navigate = useNavigate();
  const [profile, setProfile] = useState<Profile>(initialProfile);
  const [q, setQ] = useState(initialQ);
  const [listening, setListening] = useState(false);
  const [voiceLocale, setVoiceLocale] = useState<VoiceLocale>("en-IN");
  const [voiceMode, setVoiceMode] = useState<VoiceMode>("en-IN");
  const [autoVoiceAvailable, setAutoVoiceAvailable] = useState(false);
  const [voiceMessage, setVoiceMessage] = useState<string | null>(null);
  const recognitionRef = useRef<any>(null);
  const recorderRef = useRef<MediaRecorder | null>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const chunksRef = useRef<Blob[]>([]);
  const autoStopTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  // Intentionally do NOT sync `q` from initialQ — input must be fully user-controlled.
  useEffect(() => { setProfile(initialProfile); }, [initialProfile]);

  useEffect(() => {
    if (typeof window === "undefined") return;
    const deviceLocale = preferredVoiceLocale(navigator.languages ?? [navigator.language]);
    setVoiceLocale(deviceLocale);

    let storedMode: string | null = null;
    let storedLocale: string | null = null;
    try {
      storedMode = window.localStorage.getItem(VOICE_MODE_STORAGE_KEY);
      storedLocale = window.localStorage.getItem(VOICE_LOCALE_STORAGE_KEY);
    } catch {
      // Storage is optional.
    }
    if (isVoiceLocale(storedLocale)) setVoiceLocale(storedLocale);

    let cancelled = false;
    getAutoVoiceCapability().then((capability) => {
      if (cancelled) return;
      setAutoVoiceAvailable(capability.available);
      if (capability.available) {
        setVoiceMode(storedMode === "auto" || isVoiceLocale(storedMode) ? storedMode : "auto");
      } else {
        const fallback = isVoiceLocale(storedMode) ? storedMode : isVoiceLocale(storedLocale) ? storedLocale : deviceLocale;
        setVoiceMode(fallback);
      }
    }).catch(() => {
      if (cancelled) return;
      const fallback = isVoiceLocale(storedMode) ? storedMode : isVoiceLocale(storedLocale) ? storedLocale : deviceLocale;
      setVoiceMode(fallback);
    });

    return () => { cancelled = true; };
  }, []);

  useEffect(() => () => {
    try { recognitionRef.current?.abort?.(); } catch { /* no-op */ }
    recognitionRef.current = null;
    if (autoStopTimerRef.current) clearTimeout(autoStopTimerRef.current);
    autoStopTimerRef.current = null;
    try {
      if (recorderRef.current?.state === "recording") recorderRef.current.stop();
    } catch { /* no-op */ }
    recorderRef.current = null;
    streamRef.current?.getTracks().forEach((track) => track.stop());
    streamRef.current = null;
  }, []);

  const submit = (term?: string, prof?: Profile) => {
    const t = normalizeSearchQuery(term ?? q);
    const p = prof ?? profile;
    if (onSubmit) onSubmit(t, p);
    else navigate({ to: "/", search: { q: t, profile: p } });
  };

  const handleProfile = (p: Profile) => {
    setProfile(p);
    if (onProfileBrowse) {
      onProfileBrowse(p);
      return;
    }
    submit(q, p);
  };

  const handleVoiceMode = (mode: VoiceMode) => {
    if (mode === "auto" && !autoVoiceAvailable) return;
    setVoiceMode(mode);
    setVoiceMessage(null);
    if (mode !== "auto") setVoiceLocale(mode);
    if (typeof window !== "undefined") {
      try {
        window.localStorage.setItem(VOICE_MODE_STORAGE_KEY, mode);
        if (mode !== "auto") window.localStorage.setItem(VOICE_LOCALE_STORAGE_KEY, mode);
      } catch { /* optional */ }
    }
  };

  const startBrowserVoice = (locale: VoiceLocale) => {
    if (typeof window === "undefined") return;

    if (listening && recognitionRef.current) {
      try { recognitionRef.current.stop(); } catch { /* no-op */ }
      return;
    }

    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SR) {
      setVoiceMessage("Voice search is not supported by this browser.");
      return;
    }

    const rec = new SR();
    recognitionRef.current = rec;
    rec.lang = locale;
    rec.continuous = false;
    rec.interimResults = false;
    rec.maxAlternatives = 5;

    rec.onstart = () => {
      setVoiceMessage(null);
      setListening(true);
    };
    rec.onend = () => {
      setListening(false);
      recognitionRef.current = null;
    };
    rec.onerror = (event: any) => {
      const code = typeof event?.error === "string" ? event.error : "";
      setVoiceMessage(
        code === "not-allowed" || code === "service-not-allowed"
          ? "Allow microphone access to use voice search."
          : code === "no-speech"
            ? "No speech detected. Please try again."
            : "Voice recognition could not complete. Please try again.",
      );
    };
    rec.onresult = (event: any) => {
      const result = event?.results?.[0];
      if (!result) return;
      const alternatives = Array.from({ length: Math.min(result.length ?? 0, 5) }, (_, index) => ({
        transcript: result[index]?.transcript,
        confidence: result[index]?.confidence,
      }));
      const best = selectBestVoiceTranscript(alternatives);
      if (!best) {
        setVoiceMessage("Speech was heard but no usable product search was recognized.");
        return;
      }
      setQ(best.query);
      submit(best.query);
    };

    try {
      rec.start();
    } catch {
      recognitionRef.current = null;
      setListening(false);
      setVoiceMessage("Voice recognition could not start. Please try again.");
    }
  };

  const stopAutoVoice = () => {
    if (autoStopTimerRef.current) clearTimeout(autoStopTimerRef.current);
    autoStopTimerRef.current = null;
    try {
      if (recorderRef.current?.state === "recording") recorderRef.current.stop();
    } catch { /* no-op */ }
  };

  const startAutoVoice = async () => {
    if (typeof window === "undefined") return;

    if (listening && recorderRef.current) {
      stopAutoVoice();
      return;
    }

    if (!autoVoiceAvailable) {
      setVoiceMessage("Automatic language detection is not configured on this deployment. Using your device voice language instead.");
      startBrowserVoice(voiceLocale);
      return;
    }

    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") {
      setVoiceMessage("Automatic voice detection is not supported by this browser. Using your device voice language instead.");
      startBrowserVoice(voiceLocale);
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      streamRef.current = stream;
      chunksRef.current = [];
      const mimeType = recorderMimeType();
      const recorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);
      recorderRef.current = recorder;

      recorder.ondataavailable = (event) => {
        if (event.data.size > 0) chunksRef.current.push(event.data);
      };
      recorder.onstart = () => {
        setVoiceMessage("Speak in English, Hindi, Punjabi, or mix them. Tap the mic again when done.");
        setListening(true);
      };
      recorder.onerror = () => {
        setListening(false);
        setVoiceMessage("Automatic voice recording could not complete. Please try again.");
      };
      recorder.onstop = async () => {
        if (autoStopTimerRef.current) clearTimeout(autoStopTimerRef.current);
        autoStopTimerRef.current = null;
        recorderRef.current = null;
        setListening(false);
        streamRef.current?.getTracks().forEach((track) => track.stop());
        streamRef.current = null;

        const blob = new Blob(chunksRef.current, { type: recorder.mimeType || mimeType || "audio/webm" });
        chunksRef.current = [];
        if (blob.size < 256) {
          setVoiceMessage("No usable speech was recorded. Please try again.");
          return;
        }

        setVoiceMessage("Understanding your voice…");
        try {
          const audioDataUrl = await blobToDataUrl(blob);
          const result = await transcribeAutoVoice({ data: { audioDataUrl } });
          if (!result.ok || !result.transcript) {
            setVoiceMessage(
              result.status === "TIMED_OUT"
                ? "Automatic voice recognition took too long. Please try again."
                : "Automatic voice recognition is temporarily unavailable. You can choose a language fallback below.",
            );
            return;
          }

          const query = normalizeSearchQuery(result.transcript);
          if (!query) {
            setVoiceMessage("Speech was heard but no usable product search was recognized.");
            return;
          }
          setVoiceMessage(result.detectedLanguage ? `Detected ${result.detectedLanguage.toUpperCase()} automatically.` : "Language detected automatically.");
          setQ(query);
          submit(query);
        } catch {
          setVoiceMessage("Automatic voice recognition could not complete. Please try again.");
        }
      };

      recorder.start();
      autoStopTimerRef.current = setTimeout(stopAutoVoice, AUTO_VOICE_MAX_MS);
    } catch {
      recorderRef.current = null;
      streamRef.current?.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
      setListening(false);
      setVoiceMessage("Allow microphone access to use voice search.");
    }
  };

  const startVoice = () => {
    if (voiceMode === "auto") void startAutoVoice();
    else startBrowserVoice(voiceMode);
  };

  return (
    <div className="space-y-3">
      <ProfilePills value={profile} onChange={handleProfile} />
      <SearchBar
        value={q}
        onChange={setQ}
        onSubmit={() => submit()}
        voiceListening={listening}
        onVoice={startVoice}
        voiceMode={voiceMode}
        autoVoiceAvailable={autoVoiceAvailable}
        onVoiceModeChange={handleVoiceMode}
        voiceMessage={voiceMessage}
      />
      <div className="hidden items-center justify-center gap-1.5 sm:flex">
        <div className="h-px w-6 bg-white/10" />
        <p className="text-[10px] text-slate-500">
          Profile: <span className="font-bold uppercase tracking-wider text-[#38BDF8]">{profile}</span>
        </p>
        <div className="h-px w-6 bg-white/10" />
      </div>
    </div>
  );
}
